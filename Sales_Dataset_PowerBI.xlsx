const MN=["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
const P=["#f2c811","#12294f","#01b8aa","#fd625e","#8ad4eb","#a66999"];
const F={r:"",c:"",p:"",m:""};
const uniq=i=>[...new Set(D.map(x=>x[i]))].sort();
const sl=[["r","Region",uniq(2),x=>x],["c","Category",uniq(4),x=>x],["p","Product",uniq(5),x=>x],["m","Month",MN.map((_,i)=>String(i+1).padStart(2,"0")),x=>MN[+x-1]]];
const box=document.getElementById("sl");
sl.forEach(([k,n,o,f])=>{const l=document.createElement("label");l.textContent=n;const s=document.createElement("select");s.innerHTML='<option value="">All</option>'+o.map(v=>`<option value="${v}">${f(v)}</option>`).join("");s.onchange=()=>{F[k]=s.value;draw()};l.append(s);box.append(l)});
const rb=document.createElement("button");rb.textContent="Reset filters";rb.onclick=()=>{box.querySelectorAll("select").forEach(s=>s.value="");Object.keys(F).forEach(k=>F[k]="");draw()};box.append(rb);
const fm=v=>v>=1e6?"₹"+(v/1e6).toFixed(2)+"M":v>=1e3?"₹"+(v/1e3).toFixed(1)+"K":"₹"+Math.round(v);
const grp=(rows,i)=>{const m={};rows.forEach(x=>m[x[i]]=(m[x[i]]||0)+x[7]);return m};
const ink=()=>getComputedStyle(document.documentElement).getPropertyValue("--ink").trim(),mut=()=>getComputedStyle(document.documentElement).getPropertyValue("--mut").trim();
Chart.defaults.font.family='"Segoe UI",system-ui,sans-serif';
const ch={};
function mk(id,type,opt={}){ch[id]=new Chart(document.getElementById(id),{type,data:{labels:[],datasets:[{data:[]}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:type==="doughnut",position:"right"}},...opt}})}
const ax={ticks:{callback:v=>fm(v)}};
mk("ch1","line",{scales:{y:ax}});mk("ch2","bar",{indexAxis:"y",scales:{x:ax}});mk("ch3","doughnut");mk("ch4","bar",{scales:{y:ax}});mk("ch5","bar",{indexAxis:"y",scales:{x:ax}});
function set(id,m,color,keys,sort){let e=Object.entries(m);if(sort)e.sort((a,b)=>b[1]-a[1]);const c=ch[id];c.data.labels=e.map(x=>keys?keys(x[0]):x[0]);const d=c.data.datasets[0];d.data=e.map(x=>x[1]);d.backgroundColor=color;d.borderColor=id==="ch1"?"#f2c811":undefined;if(id==="ch1"){d.tension=.3;d.fill=false;d.pointBackgroundColor="#12294f"}
const t=ink(),u=mut();Chart.defaults.color=u;c.options.plugins.legend.labels={color:t};c.update()}
function draw(){
const R=D.filter(x=>(!F.r||x[2]===F.r)&&(!F.c||x[4]===F.c)&&(!F.p||x[5]===F.p)&&(!F.m||x[1].slice(5,7)===F.m));
const tot=R.reduce((a,x)=>a+x[7],0),ord=new Set(R.map(x=>x[0])).size;
const kp=[["Total Sales",fm(tot)],["Total Orders",ord.toLocaleString("en-IN")],["Average Order Value",ord?fm(tot/ord):"₹0"],["Total Products",new Set(R.map(x=>x[5])).size],["Total Regions",new Set(R.map(x=>x[2])).size]];
document.getElementById("k").innerHTML=kp.map(([a,b])=>`<div class="c"><small>${a}</small><strong>${b}</strong></div>`).join("");
const mo={};MN.forEach((_,i)=>mo[String(i+1).padStart(2,"0")]=0);R.forEach(x=>mo[x[1].slice(5,7)]+=x[7]);
set("ch1",mo,"#f2c811",k=>MN[+k-1],false);
set("ch2",grp(R,5),"#12294f",null,true);set("ch3",grp(R,4),P,null,true);set("ch4",grp(R,2),"#01b8aa",null,true);set("ch5",grp(R,3),"#fd625e",null,true)}
draw();
matchMedia("(prefers-color-scheme: dark)").addEventListener("change",draw);
</script></body></html>
